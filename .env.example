DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 本地演示可为 true；正式环境必须关闭并配置签名密钥。
HR_AGENT_ALLOW_DEMO_IDENTITY=true
HR_AGENT_AUTH_SECRET=
HR_AGENT_DEFAULT_COMPANY_ID=company_demo
HR_AGENT_DEFAULT_OPERATOR_ID=operator_demo
HR_AGENT_DEFAULT_ROLES=recruiter,hr_admin

# 留空时使用 runtime/hr_agent.sqlite；正式环境填写 PostgreSQL URL。
HR_AGENT_DATABASE_URL=
HR_AGENT_CONTROL_PLANE_DB=runtime/hr_agent.sqlite
HR_AGENT_MAX_CLARIFICATION_TURNS=5
